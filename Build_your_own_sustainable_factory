function renderDicePicker(containerId, deck){
  const container = document.getElementById(containerId);
  if(!container) return;

  container.innerHTML = "";

  for(let i=1; i<=6; i++){
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "diceBtn" + (selectedDice[deck] === i ? " active" : "");
    btn.setAttribute("data-deck", deck);
    btn.setAttribute("data-value", String(i));
    btn.setAttribute("aria-label", `${deck} dice ${i}`);
    btn.disabled = !!state.locks[deck];
    btn.innerHTML = diceFaceHtml(i);

    btn.addEventListener("click", ()=>{
      if(state.locks[deck]) return;
      selectedDice[deck] = i;
      updateDiceActive(deck);
    });

    container.appendChild(btn);
  }
}

function updateDiceActive(deck){
  document.querySelectorAll(`.diceBtn[data-deck="${deck}"]`).forEach(btn=>{
    const val = parseInt(btn.getAttribute("data-value"), 10);
    btn.classList.toggle("active", val === selectedDice[deck]);
  });
}

