      function escapeHtml(str){
        return String(str).replace(/[&<>"']/g, s => ({
          "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"
        }[s]));
      }
      function signed(n){ return (n>=0?"+":"") + n; }
      function clampInt(v,a,b){
        const n = parseInt(v,10);
        if(isNaN(n)) return a;
        return Math.max(a, Math.min(b, n));
      }

