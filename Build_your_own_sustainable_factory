      function rate(score){
        if(score >= 90) return { band:"Future-ready factory", css:"green", msg:"Integrated, preventive and resilient design" };
        if(score >= 75) return { band:"Resilient factory", css:"teal", msg:"Strong overall design with limited vulnerabilities" };
        if(score >= 60) return { band:"Sustainable factory", css:"blue", msg:"Good foundations, but material gaps remain" };
        if(score >= 40) return { band:"Developing factory", css:"orange", msg:"Several controls exist, but the system remains reactive" };
        return { band:"High-risk factory", css:"red", msg:"Critical safety, environmental or resilience exposure remains" };
      }

      // Control lookup (hidden)
      const allControls = [];
      CATEGORIES.forEach(cat => cat.controls.forEach(c => allControls.push({ ...c, catTitle: titleFor(cat.id) })));
      const byId = Object.fromEntries(allControls.map(c=>[c.id,c]));

