}

.p1{ left:2px; top:2px; }
.p2{ left:2px; top:8.5px; }
.p3{ left:2px; bottom:2px; }
.p4{ left:8.5px; top:8.5px; }
.p5{ right:2px; top:2px; }
.p6{ right:2px; top:8.5px; }
.p7{ right:2px; bottom:2px; }

.face-1 .p4{ display:block; }

.face-2 .p1,
.face-2 .p7{ display:block; }

.face-3 .p1,
.face-3 .p4,
.face-3 .p7{ display:block; }

.face-4 .p1,
.face-4 .p3,
.face-4 .p5,
.face-4 .p7{ display:block; }

.face-5 .p1,
.face-5 .p3,
.face-5 .p4,
.face-5 .p5,
.face-5 .p7{ display:block; }

.face-6 .p1,
.face-6 .p2,
.face-6 .p3,
.face-6 .p5,
