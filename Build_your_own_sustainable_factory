      function validateSetup(){
  const teamNameInput = document.getElementById("teamName");
  const factoryNameInput = document.getElementById("factoryName");
  const member1Input = document.getElementById("m1");

  const teamName = teamNameInput.value.trim();
  const factoryName = factoryNameInput.value.trim();
  const member1 = member1Input.value.trim();

  [teamNameInput, factoryNameInput, member1Input].forEach(input=>{
    input.classList.remove("inputError");
  });

  if(!teamName){
    teamNameInput.classList.add("inputError");
    showToast("Please enter a team name.");
    teamNameInput.focus();
    return false;
  }

  if(!factoryName){
    factoryNameInput.classList.add("inputError");
    showToast("Please enter a factory name.");
    factoryNameInput.focus();
    return false;
  }

  if(!member1){
    member1Input.classList.add("inputError");
    showToast("Please enter at least one team member.");
    member1Input.focus();
    return false;
  }

  return true;
}

      function syncSetup(){
        state.teamName = (document.getElementById("teamName").value || "Team").trim();
        state.factoryName = (document.getElementById("factoryName").value || "Factory").trim();
        state.members = [
          document.getElementById("m1").value.trim(),
          document.getElementById("m2").value.trim(),
          document.getElementById("m3").value.trim(),
          document.getElementById("m4").value.trim()
        ];
      }

