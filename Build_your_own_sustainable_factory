      // screens + steps
      const screens = ["s1","s2","s3","s4","s5"];
      function showScreen(id){
        screens.forEach(s => document.getElementById(s).classList.toggle("active", s===id));
        updateSteps(id);
        if(id==="s2"){ renderBoard(); }
        if(id==="s3"){ renderBaseline(); }
        if(id==="s4"){ renderCards(); }
        if(id==="s5"){ renderFinal(); }
      }
      function updateSteps(id){
        const map = { s1:1, s2:2, s3:3, s4:4, s5:5 };
        const cur = map[id] || 1;
        for(let i=1;i<=5;i++){
          const el = document.getElementById("step"+i);
          el.classList.remove("active","done");
          if(i<cur) el.classList.add("done");
          if(i===cur) el.classList.add("active");
        }
      }

