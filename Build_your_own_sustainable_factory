      const tokenPill = document.getElementById("tokenPill");
      const tokensPlacedEl = document.getElementById("tokensPlaced");
      const btnLockBaseline = document.getElementById("btnLockBaseline");
      const teamInfoEl = document.getElementById("teamInfo");
      const toast = document.getElementById("toast");

      document.getElementById("btnBackToSetup").addEventListener("click", ()=>showScreen("s1"));
      document.getElementById("btnClear").addEventListener("click", ()=>{ state.selected.clear(); recomputeTokens(); renderBoard(); updateTop(); });
      document.getElementById("btnLockBaseline").addEventListener("click", ()=>{ calculateBaseline(); showScreen("s3"); });

      function showToast(msg){
        toast.textContent = msg;
        toast.classList.add("show");
        clearTimeout(showToast._t);
        showToast._t = setTimeout(()=>toast.classList.remove("show"), 2200);
      }

      function shakeTokenPill(){
        tokenPill.classList.remove("shake");
        void tokenPill.offsetWidth;
        tokenPill.classList.add("shake");
      }

      function updateTop(){
        teamInfoEl.textContent = `${state.teamName} • ${state.factoryName}`;
        tokensPlacedEl.textContent = String(state.tokensPlaced);
        tokenPill.classList.remove("ok","full");
        tokenPill.classList.add(state.tokensPlaced < TOKEN_LIMIT ? "ok" : "full");
        btnLockBaseline.disabled = (state.selected.size === 0);
      }

      function recomputeTokens(){
        let sum = 0;
        state.selected.forEach(id => sum += (byId[id]?.cost || 0));
        state.tokensPlaced = sum;
      }
      // Render board (FIX 2: no costs, no badges)
      function renderBoard(){
  syncSetup();
  recomputeTokens();
  updateTop();

  CATEGORIES.forEach(cat=>{
    const zone = document.getElementById(cat.zoneId);
    zone.innerHTML = "";

    cat.controls.forEach(ctrl=>{
      const isSel = state.selected.has(ctrl.id);

      const card = document.createElement("div");
      card.className = "control" + (isSel ? " selected" : "");

      const buttonText = isSel
        ? "INVESTED"
        : "INVEST";

      card.innerHTML = `
        <div class="tokenChip" aria-label="Selected">✓</div>
        <div class="name">${escapeHtml(ctrl.name)}</div>
        <div class="benefit">${escapeHtml(ctrl.benefit)}</div>
        <button class="selectBtn">${buttonText}</button>
      `;

      const btn = card.querySelector(".selectBtn");
      btn.addEventListener("click", ()=>toggle(ctrl.id));

      zone.appendChild(card);
    });
  });
}

      function toggle(id){
        const ctrl = byId[id];
        if(!ctrl) return;

        if(state.selected.has(id)){
          state.selected.delete(id);
          recomputeTokens();
          renderBoard();
          updateTop();
          return;
        }

        // enforce hidden costs against limit 15
        const next = state.tokensPlaced + (ctrl.cost || 0);
        if(next > TOKEN_LIMIT){
          showToast("⚠️ Selection would exceed 15 tokens. Deselect a control first.");
          shakeTokenPill();
          return;
        }
        state.selected.add(id);
        recomputeTokens();
        renderBoard();
        updateTop();
      }

      // Screen 3 baseline
      document.getElementById("btnBackToBuild").addEventListener("click", ()=>showScreen("s2"));
      document.getElementById("btnToCards").addEventListener("click", ()=>showScreen("s4"));

      function calculateBaseline(){
        const raw = { Safety:0, Water:0, Environment:0, Energy:0, ComplianceResilience:0 };

        state.selected.forEach(id=>{
          const hs = byId[id].hidden || {};
          raw.Safety += (hs.Safety || 0);
          raw.Water += (hs.Water || 0);
          raw.Environment += (hs.Environment || 0);
          raw.Energy += (hs.Energy || 0);
          raw.ComplianceResilience += (hs.Compliance || 0) + (hs.Resilience || 0);
        });

        const capped = {
          Safety: Math.min(raw.Safety, CAPS.Safety),
          Water: Math.min(raw.Water, CAPS.Water),
          Environment: Math.min(raw.Environment, CAPS.Environment),
          Energy: Math.min(raw.Energy, CAPS.Energy),
          ComplianceResilience: Math.min(raw.ComplianceResilience, CAPS.ComplianceResilience)
        };

        const cappedTotal = capped.Safety + capped.Water + capped.Environment + capped.Energy + capped.ComplianceResilience;
        const normValue = Math.round(cappedTotal * 60 / 70);
        const coverage = [
          capped.Safety>0, capped.Water>0, capped.Environment>0, capped.Energy>0, capped.ComplianceResilience>0
        ].filter(Boolean).length;
        const balanceBonus = coverage===5 ? 10 : coverage===4 ? 6 : coverage===3 ? 3 : 0;
        const baseline = Math.min(70, normValue + balanceBonus);

        state.baseline = { raw, capped, cappedTotal, normValue, coverage, balanceBonus, baseline,
          selectedControls: Array.from(state.selected).map(id=>({ id, ...byId[id] }))
            .sort((a,b)=>a.catTitle.localeCompare(b.catTitle) || a.name.localeCompare(b.name))
        };
      }

