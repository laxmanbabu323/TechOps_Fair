function buildEventExplanation(card, effect, exposurePenalty){
  const selectedGains = card.protection
    .filter(([cid]) => state.selected.has(cid))
    .map(([cid, pts]) => `${byId[cid]?.name || cid} +${pts}`);

  const likelyLeverage = card.leverage || (card.protection[0] ? byId[card.protection[0][0]]?.name : "Relevant control");

  if(typeof exposurePenalty === "number"){
    const reason = card.exposureReason
      ? card.exposureReason(state.selected)
      : "A key control gap triggered the exposure penalty.";

    return `
      <div style="display:grid; gap:6px;">
        <div><b>Reason:</b> ${escapeHtml(reason)}</div>
        <div><b>Exposure penalty:</b> ${escapeHtml(card.exposureText || signed(effect))}</div>
        <div><b>Likely leverage point:</b> ${escapeHtml(likelyLeverage)}</div>
      </div>
    `;
  }

  if(selectedGains.length > 0){
    return `
      <div style="display:grid; gap:6px;">
        <div><b>Protection applied:</b> ${escapeHtml(selectedGains.join("; "))}</div>
        <div><b>Available gains on this card:</b> ${escapeHtml(card.gainText || "Relevant selected controls improved the score.")}</div>
        <div><b>Likely leverage point:</b> ${escapeHtml(likelyLeverage)}</div>
      </div>
    `;
  }

  return `
    <div style="display:grid; gap:6px;">
      <div><b>Reason:</b> No relevant protection control was selected.</div>
      <div><b>Effect:</b> ${signed(effect)}</div>
      <div><b>Likely leverage point:</b> ${escapeHtml(likelyLeverage)}</div>
    </div>
  `;
}

function reveal(deck){
  if(state.locks[deck]) return;

  const isBlue = deck === "blue";
  const panel = document.getElementById(isBlue ? "bluePanel" : "orangePanel");
  const btn = document.getElementById(isBlue ? "btnRevealBlue" : "btnRevealOrange");

  const n = selectedDice[deck] || 1;
  const card = (isBlue ? BLUE : ORANGE)[n];

  let bonus = 0;
let matches = 0;

card.protection.forEach(([cid, pts])=>{
  if(state.selected.has(cid)){
    matches += 1;
    bonus += pts;
  }
});

bonus = Math.min(bonus, card.cap);

const exposurePenalty = card.exposure ? card.exposure(state.selected) : null;

let effect;

if(typeof exposurePenalty === "number"){
  effect = exposurePenalty;
}else if(matches > 0){
  effect = bonus;
}else{
  effect = card.penalty;
}
const explanationHtml = buildEventExplanation(card, effect, exposurePenalty);

  const details = {
    n,
    title: card.title,
    effect
  };

  if(isBlue){
    state.round2.blue = details;

    document.getElementById("blueReveal").style.display = "block";
    document.getElementById("blueTitle").textContent = card.title;

    const el = document.getElementById("blueEffectNum");
    el.classList.remove("effectGood", "effectBad");
    el.textContent = signed(effect);
    el.classList.add(effect >= 0 ? "effectGood" : "effectBad");
    document.querySelector("#blueReveal .effectNeutral").innerHTML = explanationHtml;
    void el.offsetWidth;
    el.style.animation = "none";
    void el.offsetWidth;
    el.style.animation = "";
  } else {
    state.round2.orange = details;

    document.getElementById("orangeReveal").style.display = "block";
    document.getElementById("orangeTitle").textContent = card.title;

    const el = document.getElementById("orangeEffectNum");
    el.classList.remove("effectGood", "effectBad");
    el.textContent = signed(effect);
    el.classList.add(effect >= 0 ? "effectGood" : "effectBad");
    document.querySelector("#orangeReveal .effectNeutral").innerHTML = explanationHtml;
    void el.offsetWidth;
    el.style.animation = "none";
    void el.offsetWidth;
    el.style.animation = "";
  }

  state.locks[deck] = true;
  panel.classList.add("locked");
  btn.disabled = true;

  document.querySelectorAll(`.diceBtn[data-deck="${deck}"]`).forEach(diceBtn=>{
    diceBtn.disabled = true;
  });

  updateCalcButtonVisibility();
}
