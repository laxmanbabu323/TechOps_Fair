  background:var(--green);
  color:#fff;
  font-weight:1000;
  font-size:14px;
}

.locked input,
.locked button{
  opacity:0.55;
  cursor:not-allowed;
  pointer-events:none;
  filter:grayscale(0.1);
}

@keyframes popIn{
  0%{ transform:scale(0.86); opacity:0; }
  70%{ transform:scale(1.06); opacity:1; }
  100%{ transform:scale(1); opacity:1; }
}

