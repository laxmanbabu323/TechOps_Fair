  font-weight:1000;
  font-size:36px;
  letter-spacing:-1px;
  line-height:1;
  padding:10px 0 6px;
  animation:popIn 0.35s ease-out forwards;
  transform-origin:left center;
}

.effectGood{
  color:var(--green);
}

.effectBad{
  color:#B00020;
}

.effectNeutral{
  color:rgba(0,0,0,0.68);
  font-weight:700;
  font-size:11px;
  line-height:1.45;
}

