<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1.0" />
  <title>Build Your Sustainable Factory — Offline HSE Game</title>
  <style>
  :root{
  --novSoftWhite:#fcfcfc;
  --novWarmBlack:#161616;
  --novOrange:#ff4e00;
  --novGrey1:#dadada;
  --novGrey2:#f5f5f5;
  --novBlue:#a5bff5;
  --novPink:#eda8d1;

  --blue:#003865;
  --green:#00A651;
  --text:#161616;

  --zonePeople:#ff4e00;
  --zoneWater:#0097A7;
  --zoneWaste:#2E7D32;
  --zoneEnergy:#E65100;
  --zoneRes:#6A1B9A;

  --deckBlue:#444444;
  --deckOrange:#ff4e00;

  --journeyGradient:linear-gradient(135deg, #a5bff5 0%, #eda8d1 48%, #ff4e00 100%);
  --uiDark:#3f3f3f;
  --radius:8px;
}

*{
  box-sizing:border-box;
}

html,
body{
  height:100%;
}

body{
  margin:0;
  font-family:"Trebuchet MS", "Segoe UI", Arial, sans-serif;
  background:var(--novGrey2);
  color:var(--novWarmBlack);
  font-size:14px;
  line-height:1.45;
  letter-spacing:0.01em;
}

/* =========================================================
   NAVBAR
   ========================================================= */

.navbar{
  position:sticky;
  top:0;
  z-index:1000;
  min-height:48px;
  background:var(--novWarmBlack);
  color:var(--novSoftWhite);
  border-top:5px solid var(--novOrange);
  border-bottom:none;
  box-shadow:none;
}

.navbar-inner{
  max-width:none;
  height:48px;
  margin:0 auto;
  padding:0 14px;
  display:grid;
  grid-template-columns:220px 1fr auto;
  gap:12px;
  align-items:center;
}

.brand{
  height:38px;
  display:flex;
  align-items:center;
  justify-content:flex-start;
  gap:10px;
  background:transparent;
  margin-left:0;
  padding-left:0;
  padding-right:18px;
  min-width:0;
}

.brand .wordmark{
  display:none;
}

.novartisLogo{
  display:block;
  height:25px;
  width:auto;
  object-fit:contain;
}

.app-title{
  text-align:center;
  font-size:16px;
  font-weight:800;
  letter-spacing:0.2px;
  color:var(--novSoftWhite);
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.steps{
  display:flex;
  gap:8px;
  align-items:center;
  justify-content:flex-end;
  flex-wrap:wrap;
}

.step{
  position:relative;
  isolation:isolate;
  display:flex;
  align-items:center;
  gap:9px;
  height:30px;
  padding:3px 13px 3px 4px;
  border-radius:999px;
  background:var(--novWarmBlack);
  color:var(--novSoftWhite);
  border:1px solid rgba(252,252,252,0.28);
  font-size:13px;
  font-weight:1000;
  box-shadow:none;
  transition:transform 0.18s ease, box-shadow 0.18s ease;
}

.step::before{
  content:"";
  position:absolute;
  inset:-2px;
  z-index:-1;
  border-radius:999px;
  background:var(--journeyGradient);
  opacity:0;
  transition:opacity 0.18s ease;
}

.step .num{
  width:24px;
  height:24px;
  border-radius:999px;
  display:grid;
  place-items:center;
  border:none;
  background:var(--novOrange);
  color:var(--novSoftWhite);
  font-size:12px;
  font-weight:1000;
}

.step:hover{
  transform:translateY(-1px);
  border-color:transparent;
  box-shadow:
    0 0 0 2px rgba(255,78,0,0.18),
    0 0 14px rgba(237,168,209,0.35),
    0 0 24px rgba(165,191,245,0.30);
}

.step:hover::before{
  opacity:1;
}

.step.active{
  background:var(--novSoftWhite);
  color:var(--novWarmBlack);
  border-color:transparent;
  box-shadow:0 0 12px rgba(255,78,0,0.35);
}

.step.active::before{
  opacity:1;
}

.step.done{
  background:var(--novWarmBlack);
  color:var(--novSoftWhite);
  border:1px solid rgba(252,252,252,0.28);
}

/* =========================================================
   GLOBAL LAYOUT
   ========================================================= */

.container{
  max-width:none;
  margin:0 auto;
  padding:12px 14px 16px;
}

.screen{
  display:none;
  opacity:0;
  transform:translateY(6px);
  transition:opacity 0.18s ease, transform 0.18s ease;
  min-height:calc(100vh - 72px);
}

.screen.active{
  display:block;
  opacity:1;
  transform:translateY(0);
}

.card,
.deck,
.zone,
.control,
.revealCard{
  box-shadow:none;
}

.card{
  background:var(--novSoftWhite);
  border-radius:8px;
  border:1px solid var(--novGrey1);
}

.pad{
  padding:12px;
}

.grid-2{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:14px;
  align-items:stretch;
}

.grid-2 > .card,
.grid-2 > .deck{
  height:100%;
}

.h1{
  font-size:26px;
  font-weight:900;
  letter-spacing:-0.2px;
  margin:0;
}

.sub{
  margin-top:2px;
  font-size:13px;
  line-height:1.45;
  font-weight:600;
  color:#333;
}

label{
  height:14px;
  line-height:14px;
  margin:0;
  display:block;
  font-size:11px;
  font-weight:800;
  color:#333;
}

input{
  width:100%;
  height:30px;
  min-height:30px;
  padding:6px 10px;
  border-radius:5px;
  border:1px solid var(--novGrey1);
  background:var(--novSoftWhite);
  font-size:13px;
  font-weight:700;
  line-height:18px;
  outline:none;
}

input:focus{
  box-shadow:0 0 0 4px rgba(255,78,0,0.16);
  border-color:var(--novOrange);
}

.btn{
  border:none;
  background:var(--novOrange);
  color:var(--novSoftWhite);
  height:30px;
  min-height:30px;
  padding:6px 14px;
  border-radius:999px;
  font-size:12px;
  font-weight:800;
  cursor:pointer;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:10px;
  user-select:none;
  box-shadow:none;
  transition:transform 0.12s ease, filter 0.12s ease;
}

.btn:hover{
  transform:translateY(-1px);
  filter:brightness(1.04);
}

.btn:disabled{
  opacity:0.55;
  cursor:not-allowed;
  transform:none;
}

.btn.secondary{
  background:var(--novSoftWhite);
  color:var(--novWarmBlack);
  border:1px solid var(--novGrey1);
}

.btn.blue,
.btn.orange,
.btn.red{
  background:var(--novOrange);
  color:var(--novSoftWhite);
}

.pill,
.tokenPill{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  border-radius:999px;
  padding:6px 12px;
  background:var(--novSoftWhite);
  color:var(--novWarmBlack);
  border:1px solid var(--novGrey1);
  font-size:11px;
  font-weight:1000;
  text-transform:uppercase;
}

.chips{
  display:none !important;
}

/* =========================================================
   HERO
   ========================================================= */

.hero{
  width:100%;
  border-radius:0;
  overflow:hidden;
  box-shadow:none;
  border:1px solid var(--novGrey1);
  position:relative;
  background:var(--novSoftWhite);
  color:var(--novWarmBlack);
}

.hero-overlay{
  display:none;
}

.hero-inner{
  position:absolute;
  top:0;
  left:0;
  right:0;
  z-index:4;
  min-height:34px;
  padding:6px 14px;
  background:rgba(65,65,65,0.72);
  color:var(--novSoftWhite);
  border-bottom:none;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
  flex-wrap:wrap;
}

.hero-title{
  display:none;
}

.hero-mission{
  margin:0;
  font-size:13px;
  line-height:1.35;
  color:var(--novSoftWhite);
  font-weight:900;
  max-width:none;
}

.hero-inner .pill{
  position:relative;
  isolation:isolate;
  background:var(--novSoftWhite);
  color:var(--novWarmBlack);
  border:none;
  border-radius:999px;
  font-size:18px;
  font-weight:1000;
  padding:12px 30px;
  box-shadow:0 0 18px rgba(237,168,209,0.30);
}

.hero-inner .pill::before{
  content:"";
  position:absolute;
  inset:-2px;
  z-index:-1;
  border-radius:999px;
  background:var(--journeyGradient);
}

.scene{
  position:relative;
  height:220px;
  background:url("https://share.novartis.net/:i:/r/sites/TechOpsFair-HSEESbooth/Shared%20Documents/Digital%20board/Images/factory.png?d=wfd895de7b71e4b9b9bb8790d97a6d6ef&csf=1&web=1&e=aZEwLR") center center / cover no-repeat;
}

.scene > *{
  display:none;
}

/* =========================================================
   SCREEN 1 SETUP PAGE
   ========================================================= */

#s1 .setupTwoCards{
  margin-top:14px;
  display:grid;
  grid-template-columns:1.45fr 1fr;
  gap:14px;
  align-items:stretch;
  width:100%;
}

#s1 .setupPanel{
  background:var(--novGrey1);
  border:1px solid #cfcfcf;
  border-radius:10px;
  padding:14px;
  box-shadow:none;
  width:100%;
  min-height:174px;
  height:174px;
  display:grid;
  grid-template-rows:22px 1fr;
  overflow:hidden;
}

#s1 .setupPanelTitle{
  height:22px;
  min-height:22px;
  margin:0;
  display:flex;
  align-items:center;
  justify-content:space-between;
  color:#0067b1;
  font-size:13px;
  font-weight:1000;
  line-height:1;
}

#s1 .setupPanelTitle span{
  display:flex;
  align-items:center;
  gap:6px;
}

#s1 .setupTitleIcon{
  width:12px;
  height:12px;
  object-fit:contain;
  display:block;
  flex:0 0 auto;
}

#s1 .setupPanelTitle small{
  font-size:8px;
  font-weight:1000;
  color:rgba(0,0,0,0.55);
}

#s1 .setupFields{
  margin-top:8px;
  display:grid;
  grid-template-columns:1fr;
  grid-template-rows:36px 36px 30px;
  gap:7px;
  min-width:0;
}

#s1 .memberGrid{
  margin-top:8px;
  display:grid;
  grid-template-columns:1fr 1fr;
  grid-template-rows:36px 36px 30px;
  gap:7px 12px;
  min-width:0;
}

#s1 .setupField{
  display:grid;
  grid-template-rows:11px 24px;
  gap:2px;
  min-width:0;
}

#s1 .setupField label{
  height:11px;
  min-height:11px;
  line-height:11px;
  margin:0;
  font-size:8px;
  font-weight:900;
  color:var(--novWarmBlack);
}

#s1 .setupField input{
  height:24px;
  min-height:24px;
  padding:4px 8px;
  border-radius:5px;
  border:1px solid transparent;
  background:var(--novSoftWhite);
  color:var(--novWarmBlack);
  font-size:10px;
  font-weight:800;
  line-height:14px;
  width:100%;
  min-width:0;
}

#s1 .setupMission{
  height:30px;
  min-height:30px;
  display:flex;
  align-items:center;
  border-radius:5px;
  background:var(--novOrange);
  color:var(--novSoftWhite);
  padding:5px 9px;
  font-size:8px;
  font-weight:800;
  line-height:1.15;
  overflow:hidden;
}

#s1 .setupActions{
  grid-column:1 / -1;
  height:30px;
  min-height:30px;
  display:flex;
  align-items:center;
  justify-content:flex-end;
  gap:10px;
  min-width:0;
}

#s1 .setupActions .btn{
  height:26px;
  min-height:26px;
  padding:5px 12px;
  border-radius:999px;
  font-size:9px;
  font-weight:900;
}

#s1 .setupActions .btn.secondary{
  background:var(--novSoftWhite);
  color:#0067b1;
  border:none;
  min-width:70px;
}

#s1 #btnBeginBuild{
  background:var(--novOrange);
  color:var(--novSoftWhite);
  border:none;
  min-width:135px;
}

#s1 > .container > .card.pad{
  display:none !important;
}

.inputError{
  border-color:#B00020 !important;
  box-shadow:0 0 0 3px rgba(176,0,32,0.18) !important;
  background:#fff7f8 !important;
}

/* =========================================================
   SCREEN 2 BUILD PHASE
   ========================================================= */

#s2 .card.pad{
  background:var(--novGrey1);
}

#s2 .card.pad > div:first-child{
  align-items:center !important;
}

.stickyTop{
  position:static;
  background:transparent;
  border:none;
  box-shadow:none;
  padding:0;
  margin-top:6px !important;
}

.stickyRow{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
  flex-wrap:wrap;
}

.tokenPill{
  height:38px;
  min-height:38px;
  background:rgba(0,166,81,0.08);
  border-color:rgba(0,166,81,0.35);
  color:#0b4f2b;
}

.tokenPill.full{
  background:rgba(176,0,32,0.10);
  border-color:rgba(176,0,32,0.45);
  color:#7a0016;
}

#teamInfo{
  background:var(--novSoftWhite);
  color:var(--novWarmBlack);
  border:1px solid var(--novGrey1);
}

.factoryBoard{
  margin-top:10px;
  display:grid;
  grid-template-columns:repeat(5, minmax(0, 1fr));
  grid-template-areas:"people water waste energy res";
  gap:10px;
  align-items:stretch;
}

.zone{
  border-radius:4px;
  border:1px solid var(--novGrey1);
  box-shadow:none;
  background:var(--novSoftWhite);
  overflow:hidden;
  height:100%;
  display:flex;
  flex-direction:column;
}

.zoneHeader{
  min-height:86px;
  height:86px;
  flex:0 0 auto;
  padding:10px;
  background:var(--novSoftWhite) !important;
  color:var(--novWarmBlack) !important;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:flex-end;
  gap:6px;
  text-align:center;
  border-bottom:1px solid var(--novGrey1);
  position:relative;
  font-weight:1000;
}

.zoneHeader > div:first-child{
  font-size:12px;
  font-weight:1000;
}

.zoneHeader > div:last-child{
  display:none;
}

.zoneHeader::before{
  content:"";
  position:absolute;
  top:10px;
  left:50%;
  transform:translateX(-50%);
  width:112px;
  height:44px;
  border-radius:999px;
}

.zoneHeader::after{
  position:absolute;
  top:20px;
  left:50%;
  transform:translateX(-50%);
  width:24px;
  height:24px;
  display:grid;
  place-items:center;
  color:#fff;
  font-size:16px;
  font-weight:900;
  z-index:2;
  line-height:1;
}

.zone[style*="people"] .zoneHeader::before{
  background:
    radial-gradient(circle at 20% 50%, rgba(255,78,0,0.14) 0 18px, transparent 19px),
    radial-gradient(circle at 50% 50%, rgba(255,78,0,0.92) 0 18px, transparent 19px),
    radial-gradient(circle at 80% 50%, rgba(255,78,0,0.14) 0 18px, transparent 19px);
}

.zone[style*="people"] .zoneHeader::after{
  content:"👥";
}

.zone[style*="water"] .zoneHeader::before{
  background:
    radial-gradient(circle at 20% 50%, rgba(0,151,167,0.14) 0 18px, transparent 19px),
    radial-gradient(circle at 50% 50%, rgba(0,151,167,0.92) 0 18px, transparent 19px),
    radial-gradient(circle at 80% 50%, rgba(0,151,167,0.14) 0 18px, transparent 19px);
}

.zone[style*="water"] .zoneHeader::after{
  content:"💧";
}

.zone[style*="waste"] .zoneHeader::before{
  background:
    radial-gradient(circle at 20% 50%, rgba(46,125,50,0.14) 0 18px, transparent 19px),
    radial-gradient(circle at 50% 50%, rgba(46,125,50,0.92) 0 18px, transparent 19px),
    radial-gradient(circle at 80% 50%, rgba(46,125,50,0.14) 0 18px, transparent 19px);
}

.zone[style*="waste"] .zoneHeader::after{
  content:"🍃";
}

.zone[style*="energy"] .zoneHeader::before{
  background:
    radial-gradient(circle at 20% 50%, rgba(230,81,0,0.14) 0 18px, transparent 19px),
    radial-gradient(circle at 50% 50%, rgba(230,81,0,0.92) 0 18px, transparent 19px),
    radial-gradient(circle at 80% 50%, rgba(230,81,0,0.14) 0 18px, transparent 19px);
}

.zone[style*="energy"] .zoneHeader::after{
  content:"⚡";
}

.zone[style*="res"] .zoneHeader::before{
  background:
    radial-gradient(circle at 20% 50%, rgba(106,27,154,0.14) 0 18px, transparent 19px),
    radial-gradient(circle at 50% 50%, rgba(106,27,154,0.92) 0 18px, transparent 19px),
    radial-gradient(circle at 80% 50%, rgba(106,27,154,0.14) 0 18px, transparent 19px);
}

.zone[style*="res"] .zoneHeader::after{
  content:"🛡";
}

.zoneBody{
  flex:1;
  display:grid !important;
  grid-template-columns:1fr !important;
  gap:8px;
  padding:8px;
  background:var(--novSoftWhite);
  align-content:start;
}

.control{
  min-height:92px;
  display:grid !important;
  grid-template-rows:30px 38px 24px;
  gap:5px;
  align-items:start;
  border-radius:4px;
  border:1px solid var(--novGrey1);
  background:var(--novSoftWhite);
  padding:9px;
  box-shadow:none;
  position:relative;
}

.control .name{
  min-height:30px;
  display:flex;
  align-items:flex-start;
  font-size:12px;
  font-weight:900;
  color:rgba(0,0,0,0.78);
  line-height:1.2;
}

.control .benefit{
  min-height:38px;
  display:flex;
  align-items:flex-start;
  font-size:10px;
  line-height:1.4;
  font-weight:600;
  color:#555;
}

.control .selectBtn{
  width:100%;
  height:24px;
  min-height:24px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:3px;
  border:1px solid #e5e5e5;
  background:var(--novSoftWhite);
  font-size:10px;
  font-weight:800;
  cursor:pointer;
}

.tokenChip{
  position:absolute;
  top:7px;
  right:7px;
  width:15px;
  height:15px;
  border-radius:999px;
  color:#fff;
  font-size:9px;
  font-weight:1000;
  display:none;
  place-items:center;
  border:none;
}

.control.selected .tokenChip{
  display:grid;
}

.zone[style*="people"] .control:not(.selected) .selectBtn{
  color:#ff4e00;
}

.zone[style*="water"] .control:not(.selected) .selectBtn{
  color:#0097A7;
}

.zone[style*="waste"] .control:not(.selected) .selectBtn{
  color:#2E7D32;
}

.zone[style*="energy"] .control:not(.selected) .selectBtn{
  color:#E65100;
}

.zone[style*="res"] .control:not(.selected) .selectBtn{
  color:#6A1B9A;
}

.zone[style*="people"] .control.selected{
  background:rgba(255,78,0,0.07);
  border-color:#ff4e00;
}

.zone[style*="water"] .control.selected{
  background:rgba(0,151,167,0.07);
  border-color:#0097A7;
}

.zone[style*="waste"] .control.selected{
  background:rgba(46,125,50,0.07);
  border-color:#2E7D32;
}

.zone[style*="energy"] .control.selected{
  background:rgba(230,81,0,0.07);
  border-color:#E65100;
}

.zone[style*="res"] .control.selected{
  background:rgba(106,27,154,0.07);
  border-color:#6A1B9A;
}

.zone[style*="people"] .tokenChip{
  background:#ff4e00;
}

.zone[style*="water"] .tokenChip{
  background:#0097A7;
}

.zone[style*="waste"] .tokenChip{
  background:#2E7D32;
}

.zone[style*="energy"] .tokenChip{
  background:#E65100;
}

.zone[style*="res"] .tokenChip{
  background:#6A1B9A;
}

#btnClear{
  background:var(--novSoftWhite);
  color:var(--novWarmBlack);
  border:1px solid var(--novGrey1);
}

#btnLockBaseline{
  background:var(--novOrange);
  color:var(--novSoftWhite);
}

#s2 .note{
  display:none !important;
}

/* =========================================================
   SCREEN 3 BASELINE
   ========================================================= */

#s3,
#s3 .container{
  background:var(--novSoftWhite);
}

.baselinePage{
  background:var(--novSoftWhite);
  border:none;
  box-shadow:none;
  border-radius:8px;
  padding:0;
}

.baselineHeader{
  display:flex;
  align-items:flex-end;
  justify-content:space-between;
  gap:14px;
  flex-wrap:wrap;
  margin-bottom:12px;
}

.baselineActions{
  display:flex;
  align-items:center;
  gap:10px;
  flex-wrap:wrap;
}

.baselineScoreTop{
  background:var(--novGrey1);
  border:1px solid #cfcfcf;
  border-radius:10px;
  padding:14px;
  margin-bottom:12px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:14px;
}

.baselineScoreTitle{
  font-size:18px;
  font-weight:1000;
  color:var(--novWarmBlack);
}

.baselineScoreSub{
